# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is the only place the required
# variables are documented, so it must ship.
!.env.example

# Local file-store data (BRIDGER_STORE=file). Contains token HASHES and the
# ledger — not tokens themselves, but it is still someone's private record.
.bridger-data/
# A bridge materialised into THIS repo while dogfooding.
/bridger/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ready-to-paste client configs containing LIVE room tokens.
.local/
.vercel
.upstash-cost-probe.mts

# Local-only, never published. The disclosure name list would otherwise
# publish exactly the names it protects; the settings file grants tool
# permissions and belongs to this machine, not to the repo.
.disclosure-names.local.json
.claude/settings.local.json

# Internal working docs -- NOT for public view (gaveled S#286, enforced S#290).
# "Remove it and make sure docs like that aren't pushed to a public viewing,
#  this is our internal stuff, worst case scenario they can leak API keys."
# scripts/check-disclosure.mjs FAILS if any of these become tracked again.
/DECISIONS.md
/STATUS.md
/TODO.md
