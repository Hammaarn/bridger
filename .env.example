# Bridger environment.
#
# There is deliberately NO ANTHROPIC_API_KEY here. Bridger calls no model:
# it is an MCP tool server that each side's existing Claude Code session
# calls, so both sides run on their subscription and the only running cost
# is Vercel invocations plus Redis commands.

# ── server + operator CLI ────────────────────────────────────────
# The registry and the ledger. Give Bridger its OWN Upstash database —
# sharing one with another project makes a revoke on the wrong instance
# look like success while the real key keeps working.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── break-glass ──────────────────────────────────────────────────
# Stops the bridge without touching Redis. Checked before any read.
# BRIDGER_DISABLED=true

# ── partner CLI only ─────────────────────────────────────────────
# Your partner sets ONLY this. Never a database credential.
# BRIDGER_TOKEN=br_live_...
